#!/bin/bash

cat > ../include/fsdevice_list.h << EOF
/*
 * Do not hand edit. This file is autogenerated
 */

EOF

for a in modules/fsdevice/*.c
do
	str=`grep FSDEVICE_REGISTER ${a}`

	if [ $? -eq 0 ] # String found
	then
		newstr=`echo $str | /usr/bin/cut -d"(" -f2 | /usr/bin/cut -d ")" -f1`

		echo "extern fs_device *${newstr} (void);" >> ../include/fsdevice_list.h	
	fi

done

cat >> ../include/fsdevice_list.h << EOF
static struct { fs_device * (*register_function) (void); } fs_device_driver_list[] =
	{
EOF

for a in modules/fsdevice/*.c
do
	str=`grep FSDEVICE_REGISTER ${a}`

	if [ $? -eq 0 ] # String found
	then
		newstr=`echo $str | /usr/bin/cut -d"(" -f2 | /usr/bin/cut -d ")" -f1`

		echo "	{ ${newstr} }," >> ../include/fsdevice_list.h	
	fi

done

cat >> ../include/fsdevice_list.h <<EOF
	{ NULL }
	};
EOF
